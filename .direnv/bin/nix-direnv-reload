#!/usr/bin/env bash
set -e
if [[ ! -d "/Users/pedro021/Documents/UVG/4th-year/Models-Simulacion/Project-1-Simulation" ]]; then
  echo "Cannot find source directory; Did you move it?"
  echo "(Looking for "/Users/pedro021/Documents/UVG/4th-year/Models-Simulacion/Project-1-Simulation")"
  echo 'Cannot force reload with this script - use "direnv reload" manually and then try again'
  exit 1
fi

# rebuild the cache forcefully
_nix_direnv_force_reload=1 direnv exec "/Users/pedro021/Documents/UVG/4th-year/Models-Simulacion/Project-1-Simulation" true

# Update the mtime for .envrc.
# This will cause direnv to reload again - but without re-building.
touch "/Users/pedro021/Documents/UVG/4th-year/Models-Simulacion/Project-1-Simulation/.envrc"

# Also update the timestamp of whatever profile_rc we have.
# This makes sure that we know we are up to date.
touch -r "/Users/pedro021/Documents/UVG/4th-year/Models-Simulacion/Project-1-Simulation/.envrc" "/Users/pedro021/Documents/UVG/4th-year/Models-Simulacion/Project-1-Simulation/.direnv"/*.rc
